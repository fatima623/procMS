# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# MySQL 8+. Local dev example: mysql://root:@localhost:3306/procurement
# Aiven production example (SSL required, keep the pool small on serverless):
#   mysql://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/DBNAME?ssl-mode=REQUIRED&connection_limit=3
DATABASE_URL="mysql://root:@localhost:3306/procurement"
# Separate URL for migrations when using a connection pooler (optional).
# DIRECT_URL=""

# ------------------------------------------------------------------------------
# Auth (NextAuth v5)
# ------------------------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
# Comma-separated allow-list for CORS (web UI origins). Leave empty to disallow.
ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# Observability (optional — safe to leave blank in dev)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="procurement-api"

# ------------------------------------------------------------------------------
# OIDC / SSO (optional — leave blank to disable)
# Set all four to light up the SSO option on the sign-in page.
# ------------------------------------------------------------------------------
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="Corporate SSO"

# ------------------------------------------------------------------------------
# Weekly digest email
# Comma-separated extra recipients in addition to admins + senior roles.
# ------------------------------------------------------------------------------
DIGEST_RECIPIENTS=""

# ------------------------------------------------------------------------------
# SMTP (optional — leave SMTP_HOST blank to log emails to stdout instead)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DP-N Procurement <no-reply@localhost>"

# ------------------------------------------------------------------------------
# In-process scheduler (optional)
# When ENABLE_SCHEDULER=true, weekly digest + nightly cleanup run inside the
# Node server. Leave blank in prod if you prefer external cron hitting
# /api/jobs/*.
# ------------------------------------------------------------------------------
ENABLE_SCHEDULER=""
SCHEDULER_DIGEST_DAY="1"   # 0=Sun … 6=Sat
SCHEDULER_DIGEST_HOUR="7"  # UTC
SCHEDULER_API_TOKEN=""     # shared secret for /api/jobs/* when scheduler is NOT in-process
