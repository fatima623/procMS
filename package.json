{
  "name": "procurement-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "DP-Navy procurement workflow — Next.js + MySQL + Prisma",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "1.27.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ulid": "2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "nodemailer": "^10.2.1",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
