// =============================================================================
// Procurement Management System — Prisma schema (MySQL)
//
// Models the DP(Navy) procurement workflow:
//
//   Indenter  →  CR Section  →  Budget Section  →  COORD Section
//             →  Concerned ADP (vet + control number)
//             →  SUPTD  →  AD → DD → DP(N) → DGDP → Secy DP      [Chain #1 — indent approval]
//             →  Concerned ADP (prepare IT Issue Proforma)
//             →  AD → DD → DP(N)                                 [Chain #2 — IT approval]
//             →  Concerned Section dispatches IT to Firms
//             →  Firms submit Technical Offers
//             →  Inspectorate TSR  (queries ↔ firms, firms accepted/rejected)
//             →  Opening of Commercial Offers (technically accepted firms)
//             →  Preparation of CST
//             →  AD → DD  (and AD → DD → DP(N) → DGDP → Secy DP if single quote)   [Chain #3 — CST approval]
//             →  Purchase Requisition faxed to winning firm
//
// Design notes:
//   - PKs are string ULIDs generated in the domain layer (sortable, URL-safe,
//     opaque; avoids leaking row counts).
//   - Monetary values are Decimal(20,4) — never Float. Currency is stored
//     alongside amounts.
//   - Row-level optimistic concurrency uses `version`.
//   - State machines are enforced in the aggregate; enums here are the storage
//     surface only.
//   - All timestamps are UTC. The UI layer converts to the viewer's zone.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "relationJoins"]
  // Vercel's Node 20 serverless runtime is RHEL 8 / OpenSSL 3; ship both the
  // local dev binary and the Vercel one so `prisma generate` on either host
  // produces a client that boots on both.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity & organisation
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  INDENTER
  CR_STAFF
  BUDGET_STAFF
  COORD_STAFF
  ADP_STAFF
  SUPTD
  AD
  DD
  DP_N
  DGDP
  SECY_DP
  CPO
  INSPECTORATE
  FIRM_REP
}

enum SectionKind {
  INDENTER
  CR
  BUDGET
  COORD
  ADP
  SUPTD
  DP_OFFICE
  INSPECTORATE
  OTHER
}

model User {
  id            String    @id @db.VarChar(26)
  email         String    @unique @db.VarChar(254)
  passwordHash  String    @db.VarChar(100)
  displayName   String    @db.VarChar(120)
  rank          String?   @db.VarChar(60)
  isActive      Boolean   @default(true)
  firmId        String?   @db.VarChar(26) // only populated for FIRM_REP users
  totpSecret    String?   @db.VarChar(64) // base32 TOTP shared secret (RFC 6238)
  totpEnabledAt DateTime? @db.DateTime(6)
  createdAt     DateTime  @default(now()) @db.DateTime(6)
  updatedAt     DateTime  @updatedAt @db.DateTime(6)
  version       Int       @default(0)

  roles       UserRole[]
  memberships SectionMember[]
  firm        Firm?           @relation(fields: [firmId], references: [id])

  submittedIndents     Indent[]             @relation("IndenterToIndent")
  decidedSteps         ApprovalStep[]       @relation("DecidedBy")
  raisedObservations   Observation[]        @relation("RaisedBy")
  resolvedObservations Observation[]        @relation("ResolvedBy")
  auditLogs            AuditLog[]
  notifications        Notification[]
  authoredComments     Comment[]            @relation("CommentAuthor")
  passwordResetTokens  PasswordResetToken[]

  @@index([firmId])
}

model PasswordResetToken {
  id        String    @id @db.VarChar(26)
  userId    String    @db.VarChar(26)
  tokenHash String    @db.VarChar(64)
  expiresAt DateTime  @db.DateTime(6)
  usedAt    DateTime? @db.DateTime(6)
  createdAt DateTime  @default(now()) @db.DateTime(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model UserRole {
  userId String @db.VarChar(26)
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model Section {
  id        String      @id @db.VarChar(26)
  code      String      @unique @db.VarChar(40) // e.g. "ADP-1", "COORD", "SUPTD"
  name      String      @db.VarChar(160)
  kind      SectionKind
  parentId  String?     @db.VarChar(26)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.DateTime(6)
  updatedAt DateTime    @updatedAt @db.DateTime(6)

  parent      Section?        @relation("SectionTree", fields: [parentId], references: [id])
  children    Section[]       @relation("SectionTree")
  members     SectionMember[]
  indents     Indent[]        @relation("OwningSection")
  assignedAdp Indent[]        @relation("AssignedAdp")

  @@index([kind])
  @@index([parentId])
}

model SectionMember {
  userId    String  @db.VarChar(26)
  sectionId String  @db.VarChar(26)
  isHead    Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([sectionId])
}

// -----------------------------------------------------------------------------
// Reference data
// -----------------------------------------------------------------------------

model FiscalYear {
  id        String   @id @db.VarChar(26)
  label     String   @unique @db.VarChar(20) // "2026-27"
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(6)

  budgetAllocations      BudgetAllocation[]
  indents                Indent[]
  annualProcurementPlans AnnualProcurementPlan[]
}

model BudgetHead {
  id          String   @id @db.VarChar(26)
  code        String   @unique @db.VarChar(40)
  description String   @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(6)

  allocations            BudgetAllocation[]
  indents                Indent[]
  annualPlanItems        AnnualProcurementPlanItem[]
}

model BudgetAllocation {
  id           String   @id @db.VarChar(26)
  fiscalYearId String   @db.VarChar(26)
  budgetHeadId String   @db.VarChar(26)
  sectionId    String?  @db.VarChar(26)
  allocated    Decimal  @db.Decimal(20, 4)
  reserved     Decimal  @default(0) @db.Decimal(20, 4)
  spent        Decimal  @default(0) @db.Decimal(20, 4)
  currency     String   @default("PKR") @db.VarChar(3)
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @db.DateTime(6)
  updatedAt    DateTime @updatedAt @db.DateTime(6)

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  budgetHead BudgetHead @relation(fields: [budgetHeadId], references: [id])

  @@unique([fiscalYearId, budgetHeadId, sectionId])
  @@index([budgetHeadId])
}

model Firm {
  id            String   @id @db.VarChar(26)
  code          String   @unique @db.VarChar(40)
  name          String   @db.VarChar(255)
  ntn           String?  @db.VarChar(40)
  address       String?  @db.VarChar(500)
  city          String?  @db.VarChar(120)
  country       String?  @db.VarChar(120)
  email         String?  @db.VarChar(254)
  phone         String?  @db.VarChar(60)
  isBlacklisted Boolean  @default(false) // denormalised cache; derived from Blacklist rows with status=ACTIVE
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.DateTime(6)
  updatedAt     DateTime @updatedAt @db.DateTime(6)

  users                User[]
  itInvites            ITFirmInvite[]
  technicalOffers      TechnicalOffer[]
  commercialOffers     CommercialOffer[]
  tsrQueries           TSRQuery[]
  purchaseRequisitions PurchaseRequisition[]
  contracts            Contract[]
  blacklists           Blacklist[]
  grievances           Grievance[]
  integrityPacts       IntegrityPact[]
  registrations        FirmRegistration[]
}

// -----------------------------------------------------------------------------
// Indent (procurement request)
// -----------------------------------------------------------------------------

enum IndentType {
  NORMAL
  PROPRIETY // propriety indent — needs CPO approval before chain
}

// Case classifiers added for compliance evaluation (ZeroLink merge).
// PPRA obligations branch on the procurement method, the goods/works/services
// category and whether the proceeding is international competitive bidding.
enum ProcurementMethod {
  OPEN_COMPETITIVE_BIDDING
  LIMITED_BIDDING
  RFQ
  DIRECT_CONTRACTING
}

enum ProcurementCategory {
  GOODS
  WORKS
  SERVICES
}

enum IndentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IndentStatus {
  DRAFT
  SUBMITTED // indenter has submitted; waiting for CR
  CR_RECEIVED // CR Section received; waiting to forward
  BUDGET_CHECK // Budget Section verifying availability
  BUDGET_REJECTED
  COORD_VETTING // COORD Section vetting
  ADP_VETTING // Concerned ADP checking/vetting
  ADP_OBSERVED // ADP raised observations
  SUPTD_VETTING
  INDENT_APPROVAL // Chain #1 running
  INDENT_REJECTED
  CPO_APPROVAL // propriety indent waiting on CPO
  IT_PREPARATION // Concerned ADP preparing IT Issue Proforma
  IT_APPROVAL // Chain #2 running
  IT_DISPATCHED // IT docs sent to firms
  TECH_OFFERS_OPEN // firms submitting technical offers
  TSR_IN_PROGRESS // Inspectorate preparing TSR
  COMMERCIAL_OPEN // Commercial offers being opened
  CST_PREPARATION
  CST_APPROVAL // Chain #3 running
  PR_ISSUED
  CLOSED
  CANCELLED
}

model Indent {
  id            String         @id @db.VarChar(26)
  indentNumber  String         @unique @db.VarChar(40)
  controlNumber String?        @unique @db.VarChar(40)
  subject       String         @db.VarChar(500)
  justification String?        @db.Text
  type          IndentType     @default(NORMAL)
  priority      IndentPriority @default(NORMAL)
  status        IndentStatus   @default(DRAFT)

  // Compliance classifiers (ZeroLink merge — PPRA method/category/ICB rules)
  method          ProcurementMethod   @default(OPEN_COMPETITIVE_BIDDING)
  category        ProcurementCategory @default(GOODS)
  isInternational Boolean             @default(false)

  estimatedValue Decimal @db.Decimal(20, 4)
  currency       String  @default("PKR") @db.VarChar(3)

  indenterId     String  @db.VarChar(26)
  sectionId      String  @db.VarChar(26) // owning section (indenter's)
  assignedAdpId  String? @db.VarChar(26) // Concerned ADP section
  fiscalYearId   String  @db.VarChar(26)
  budgetHeadId   String  @db.VarChar(26)
  plannedItemId  String? @db.VarChar(26) // optional link to annual plan item (PPRA Rule 8)

  submittedAt     DateTime? @db.DateTime(6)
  closedAt        DateTime? @db.DateTime(6)
  cancelledAt     DateTime? @db.DateTime(6)
  cancelledReason String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)
  version   Int      @default(0)

  indenter    User                        @relation("IndenterToIndent", fields: [indenterId], references: [id])
  section     Section                     @relation("OwningSection", fields: [sectionId], references: [id])
  assignedAdp Section?                    @relation("AssignedAdp", fields: [assignedAdpId], references: [id])
  fiscalYear  FiscalYear                  @relation(fields: [fiscalYearId], references: [id])
  budgetHead  BudgetHead                  @relation(fields: [budgetHeadId], references: [id])
  plannedItem AnnualProcurementPlanItem?  @relation("PlanItemToIndent", fields: [plannedItemId], references: [id])

  items          IndentItem[]
  itPerforma     ITPerforma?
  observations   Observation[]
  attachments    Attachment[]          @relation("IndentAttachments")
  statusHistory  IndentStatusHistory[]
  comments       Comment[]
  advertisements Advertisement[]
  contract       Contract?
  grievances     Grievance[]
  integrityPacts IntegrityPact[]

  @@index([status])
  @@index([sectionId])
  @@index([assignedAdpId])
  @@index([fiscalYearId, budgetHeadId])
}

model IndentItem {
  id                 String  @id @db.VarChar(26)
  indentId           String  @db.VarChar(26)
  lineNo             Int
  itemCode           String? @db.VarChar(80)
  description        String  @db.VarChar(1000)
  specifications     Json?
  quantity           Decimal @db.Decimal(20, 4)
  uom                String  @db.VarChar(20)
  estimatedUnitPrice Decimal @db.Decimal(20, 4)
  currency           String  @default("PKR") @db.VarChar(3)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@unique([indentId, lineNo])
  @@index([indentId])
}

model IndentStatusHistory {
  id          String       @id @db.VarChar(26)
  indentId    String       @db.VarChar(26)
  fromStatus  IndentStatus
  toStatus    IndentStatus
  actorUserId String       @db.VarChar(26)
  reason      String?      @db.VarChar(500)
  occurredAt  DateTime     @default(now()) @db.DateTime(6)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId, occurredAt])
}

// -----------------------------------------------------------------------------
// Approval chains (reusable across Indent / IT Proforma / CST)
// -----------------------------------------------------------------------------

enum ApprovalSubject {
  INDENT
  IT_PROFORMA
  CST
}

enum ApprovalChainStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED // step returned the file for rework
  SKIPPED
}

model ApprovalChain {
  id           String              @id @db.VarChar(26)
  subject      ApprovalSubject
  subjectId    String              @db.VarChar(26)
  status       ApprovalChainStatus @default(PENDING)
  currentIndex Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.DateTime(6)
  updatedAt    DateTime            @updatedAt @db.DateTime(6)
  completedAt  DateTime?           @db.DateTime(6)
  version      Int                 @default(0)

  steps ApprovalStep[]

  @@unique([subject, subjectId])
  @@index([status])
}

model ApprovalStep {
  id              String             @id @db.VarChar(26)
  chainId         String             @db.VarChar(26)
  stepIndex       Int
  role            Role
  assignedUserId  String?            @db.VarChar(26)
  status          ApprovalStepStatus @default(PENDING)
  decidedByUserId String?            @db.VarChar(26)
  decidedAt       DateTime?          @db.DateTime(6)
  comments        String?            @db.Text

  chain     ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation("DecidedBy", fields: [decidedByUserId], references: [id])

  @@unique([chainId, stepIndex])
  @@index([status])
  @@index([assignedUserId])
}

// -----------------------------------------------------------------------------
// Observations (queries raised during vetting)
// -----------------------------------------------------------------------------

enum ObservationStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

model Observation {
  id               String            @id @db.VarChar(26)
  indentId         String            @db.VarChar(26)
  raisedByUserId   String            @db.VarChar(26)
  raisedToUserId   String?           @db.VarChar(26)
  note             String            @db.Text
  status           ObservationStatus @default(OPEN)
  resolution       String?           @db.Text
  resolvedByUserId String?           @db.VarChar(26)
  resolvedAt       DateTime?         @db.DateTime(6)
  createdAt        DateTime          @default(now()) @db.DateTime(6)

  indent     Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  raisedBy   User   @relation("RaisedBy", fields: [raisedByUserId], references: [id])
  resolvedBy User?  @relation("ResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([indentId, status])
}

// -----------------------------------------------------------------------------
// IT (Invitation to Tender) Issue Proforma
// -----------------------------------------------------------------------------

enum ITStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  DISPATCHED
  CLOSED
  CANCELLED
}

model ITPerforma {
  id               String    @id @db.VarChar(26)
  indentId         String    @unique @db.VarChar(26)
  reference        String    @unique @db.VarChar(60)
  checklist        Json?
  status           ITStatus  @default(DRAFT)
  dispatchedAt     DateTime? @db.DateTime(6)
  closingAt        DateTime? @db.DateTime(6)
  preparedByUserId String    @db.VarChar(26)
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @db.DateTime(6)
  updatedAt        DateTime  @updatedAt @db.DateTime(6)

  indent Indent @relation(fields: [indentId], references: [id])

  firms            ITFirmInvite[]
  technicalOffers  TechnicalOffer[]
  commercialOffers CommercialOffer[]
  tsr              TechnicalScrutinyReport?
  cst              CST?

  @@index([status])
}

model ITFirmInvite {
  itPerformaId String   @db.VarChar(26)
  firmId       String   @db.VarChar(26)
  invitedAt    DateTime @default(now()) @db.DateTime(6)

  itPerforma ITPerforma @relation(fields: [itPerformaId], references: [id], onDelete: Cascade)
  firm       Firm       @relation(fields: [firmId], references: [id])

  @@id([itPerformaId, firmId])
}

// -----------------------------------------------------------------------------
// Technical phase
// -----------------------------------------------------------------------------

enum OfferStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model TechnicalOffer {
  id           String      @id @db.VarChar(26)
  itPerformaId String      @db.VarChar(26)
  firmId       String      @db.VarChar(26)
  submittedAt  DateTime    @default(now()) @db.DateTime(6)
  documentKey  String?     @db.VarChar(500) // object-storage key
  status       OfferStatus @default(RECEIVED)
  remarks      String?     @db.Text
  version      Int         @default(0)

  itPerforma     ITPerforma      @relation(fields: [itPerformaId], references: [id], onDelete: Cascade)
  firm           Firm            @relation(fields: [firmId], references: [id])
  tsrEvaluations TSREvaluation[]

  @@unique([itPerformaId, firmId])
  @@index([status])
}

enum TSRStatus {
  DRAFT
  SUBMITTED
  QUERIES_RAISED
  COMPLETED
}

model TechnicalScrutinyReport {
  id                 String    @id @db.VarChar(26)
  itPerformaId       String    @unique @db.VarChar(26)
  inspectorateUserId String    @db.VarChar(26)
  status             TSRStatus @default(DRAFT)
  submittedAt        DateTime? @db.DateTime(6)
  completedAt        DateTime? @db.DateTime(6)
  summary            String?   @db.Text

  itPerforma  ITPerforma      @relation(fields: [itPerformaId], references: [id], onDelete: Cascade)
  evaluations TSREvaluation[]
  queries     TSRQuery[]
}

enum TSRVerdict {
  ACCEPTED
  REJECTED
  NEEDS_QUERY
}

model TSREvaluation {
  id               String     @id @db.VarChar(26)
  tsrId            String     @db.VarChar(26)
  technicalOfferId String     @db.VarChar(26)
  verdict          TSRVerdict
  remarks          String?    @db.Text
  evaluatedAt      DateTime   @default(now()) @db.DateTime(6)

  tsr            TechnicalScrutinyReport @relation(fields: [tsrId], references: [id], onDelete: Cascade)
  technicalOffer TechnicalOffer          @relation(fields: [technicalOfferId], references: [id])

  @@unique([tsrId, technicalOfferId])
}

enum TSRQueryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model TSRQuery {
  id         String         @id @db.VarChar(26)
  tsrId      String         @db.VarChar(26)
  firmId     String         @db.VarChar(26)
  question   String         @db.Text
  response   String?        @db.Text
  status     TSRQueryStatus @default(OPEN)
  askedAt    DateTime       @default(now()) @db.DateTime(6)
  answeredAt DateTime?      @db.DateTime(6)

  tsr  TechnicalScrutinyReport @relation(fields: [tsrId], references: [id], onDelete: Cascade)
  firm Firm                    @relation(fields: [firmId], references: [id])

  @@index([status])
}

// -----------------------------------------------------------------------------
// Commercial phase + CST
// -----------------------------------------------------------------------------

model CommercialOffer {
  id                String      @id @db.VarChar(26)
  itPerformaId      String      @db.VarChar(26)
  firmId            String      @db.VarChar(26)
  openedAt          DateTime    @default(now()) @db.DateTime(6)
  totalPrice        Decimal     @db.Decimal(20, 4)
  currency          String      @default("PKR") @db.VarChar(3)
  bidSecurityAmount Decimal?    @db.Decimal(20, 4) // ZeroLink merge — PPRA r25 (bid security ≤ 5% of estimate)
  deliveryWeeks     Int?
  status            OfferStatus @default(RECEIVED)
  documentKey       String?     @db.VarChar(500)
  version           Int         @default(0)

  itPerforma ITPerforma @relation(fields: [itPerformaId], references: [id], onDelete: Cascade)
  firm       Firm       @relation(fields: [firmId], references: [id])
  cstLines   CSTLine[]

  @@unique([itPerformaId, firmId])
  @@index([status])
}

enum CSTStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  REJECTED
}

model CST {
  id                  String    @id @db.VarChar(26)
  itPerformaId        String    @unique @db.VarChar(26)
  preparedByUserId    String    @db.VarChar(26)
  status              CSTStatus @default(DRAFT)
  singleQuote         Boolean   @default(false)
  approvalPerformaKey String?   @db.VarChar(500)
  approvedAt          DateTime? @db.DateTime(6)
  version             Int       @default(0)
  createdAt           DateTime  @default(now()) @db.DateTime(6)
  updatedAt           DateTime  @updatedAt @db.DateTime(6)

  itPerforma          ITPerforma           @relation(fields: [itPerformaId], references: [id])
  lines               CSTLine[]
  purchaseRequisition PurchaseRequisition?
}

model CSTLine {
  id                  String  @id @db.VarChar(26)
  cstId               String  @db.VarChar(26)
  commercialOfferId   String  @db.VarChar(26)
  rank                Int
  recommendedForAward Boolean @default(false)
  justification       String? @db.Text

  cst             CST             @relation(fields: [cstId], references: [id], onDelete: Cascade)
  commercialOffer CommercialOffer @relation(fields: [commercialOfferId], references: [id])

  @@unique([cstId, commercialOfferId])
  @@index([cstId, rank])
}

// -----------------------------------------------------------------------------
// Purchase Requisition — final award to the firm
// -----------------------------------------------------------------------------

enum PRStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  CLOSED
}

model PurchaseRequisition {
  id        String    @id @db.VarChar(26)
  cstId     String    @unique @db.VarChar(26)
  firmId    String    @db.VarChar(26)
  prNumber  String    @unique @db.VarChar(60)
  amount    Decimal   @db.Decimal(20, 4)
  currency  String    @default("PKR") @db.VarChar(3)
  faxedAt   DateTime? @db.DateTime(6)
  status    PRStatus  @default(DRAFT)
  createdAt DateTime  @default(now()) @db.DateTime(6)
  updatedAt DateTime  @updatedAt @db.DateTime(6)

  cst      CST       @relation(fields: [cstId], references: [id])
  firm     Firm      @relation(fields: [firmId], references: [id])
  contract Contract?
}

// -----------------------------------------------------------------------------
// Attachments + Audit log (cross-cutting)
// -----------------------------------------------------------------------------

enum AttachmentSubject {
  INDENT
  IT_PROFORMA
  TECH_OFFER
  COMMERCIAL_OFFER
  TSR
  CST
  PR
  OBSERVATION
}

model Attachment {
  id               String            @id @db.VarChar(26)
  subject          AttachmentSubject
  subjectId        String            @db.VarChar(26)
  originalName     String            @db.VarChar(255)
  storageKey       String            @db.VarChar(500) // S3-like object key
  mimeType         String            @db.VarChar(120)
  sizeBytes        BigInt
  checksumSha256   String?           @db.VarChar(64)
  uploadedByUserId String            @db.VarChar(26)
  uploadedAt       DateTime          @default(now()) @db.DateTime(6)

  indent Indent? @relation("IndentAttachments", fields: [subjectId], references: [id], map: "Attachment_Indent_fk")

  @@index([subject, subjectId])
}

// -----------------------------------------------------------------------------
// In-app notifications
// -----------------------------------------------------------------------------

model Notification {
  id        String    @id @db.VarChar(26)
  userId    String    @db.VarChar(26)
  type      String    @db.VarChar(60) // e.g. "approval.waiting", "pr.issued"
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  href      String?   @db.VarChar(500) // in-app link to the relevant screen
  readAt    DateTime? @db.DateTime(6)
  createdAt DateTime  @default(now()) @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Comments / activity feed on an indent (free-form conversation; separate
// from Observations which gate the workflow)
// -----------------------------------------------------------------------------

model Comment {
  id        String    @id @db.VarChar(26)
  indentId  String    @db.VarChar(26)
  authorId  String    @db.VarChar(26)
  body      String    @db.Text
  parentId  String?   @db.VarChar(26)
  createdAt DateTime  @default(now()) @db.DateTime(6)
  deletedAt DateTime? @db.DateTime(6)

  indent  Indent    @relation(fields: [indentId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([indentId, createdAt])
  @@index([parentId])
}

model DigestRecipient {
  id        String   @id @db.VarChar(26)
  email     String   @unique @db.VarChar(254)
  label     String?  @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(6)

  @@index([isActive])
}

model AuditLog {
  id          String   @id @db.VarChar(26)
  actorUserId String?  @db.VarChar(26)
  action      String   @db.VarChar(80) // e.g. "indent.submit", "approval.decide"
  subjectType String   @db.VarChar(40)
  subjectId   String   @db.VarChar(26)
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  occurredAt  DateTime @default(now()) @db.DateTime(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([subjectType, subjectId, occurredAt])
  @@index([actorUserId, occurredAt])
}

// =============================================================================
// Execution-half (ZeroLink compliance merge)
//
// The DP(Navy) flow above stops at the Purchase Requisition (award). These models
// add the post-award / execution lifecycle that PPRA and DPP&I-35 obligations
// govern but the base system did not record: advertisement timeline, bid security,
// the signed contract instrument, guarantees, invoices/payments and letters of
// credit. Added so the compliance engine has columns to bind r9/r13/r25/r39/r43/
// r45 and the DPP&I-35 LC-amendment rule against.
//
// Design: amounts Decimal(20,4) + currency; dates are @db.Date (a legal date, not
// a system timestamp — compliance measures calendar intervals over these). The
// Contract carries a DIRECT `indentId` so the whole execution subtree joins to the
// case without threading the CST/IT intermediate aggregates.
// =============================================================================

enum AdvertisementMedium {
  PPRA_WEBSITE
  NEWSPAPER
  EPADS
  OTHER
}

model Advertisement {
  id                    String              @id @db.VarChar(26)
  indentId              String              @db.VarChar(26)
  medium                AdvertisementMedium @default(PPRA_WEBSITE)
  publishedOn           DateTime            @db.Date // advertisement first published
  biddingDocsIssuedOn   DateTime?           @db.Date // bidding documents made available
  bidSubmissionDeadline DateTime?           @db.Date
  createdAt             DateTime            @default(now()) @db.DateTime(6)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId])
}

enum ExecutionContractStatus {
  SIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  TERMINATED
}

model Contract {
  id                    String                  @id @db.VarChar(26)
  indentId              String                  @unique @db.VarChar(26) // one per proceeding; direct case link
  purchaseRequisitionId String?                 @unique @db.VarChar(26)
  firmId                String                  @db.VarChar(26)
  contractNumber        String                  @unique @db.VarChar(60)
  value                 Decimal                 @db.Decimal(20, 4)
  currency              String                  @default("PKR") @db.VarChar(3)
  awardedOn             DateTime?               @db.Date
  signedOn              DateTime?               @db.Date
  originalDP            DateTime?               @db.Date // original delivery period (DPP&I-35 Ch XIII)
  status                ExecutionContractStatus @default(SIGNED)
  takingOverCertifiedOn DateTime?               @db.Date // taking-over certificate issued
  closedOn              DateTime?               @db.Date // contract formally closed
  version               Int                     @default(0)
  createdAt             DateTime                @default(now()) @db.DateTime(6)
  updatedAt             DateTime                @updatedAt @db.DateTime(6)

  indent              Indent               @relation(fields: [indentId], references: [id])
  firm                Firm                 @relation(fields: [firmId], references: [id])
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])

  guarantees        Guarantee[]
  invoices          Invoice[]
  payments          Payment[]
  lettersOfCredit   LetterOfCredit[]
  dpExtensions      DeliveryPeriodExtension[]
  liquidatedDamages LiquidatedDamages[]
  inspections       Inspection[]
  amendments        ContractAmendment[]
  insurances        Insurance[]
  shipments         Shipment[]
  endUserCerts      EndUserCertificate[]
  agentCommissions  AgentCommission[]

  @@index([firmId])
  @@index([status])
}

enum GuaranteeType {
  BID_SECURITY
  PERFORMANCE
  ADVANCE_PAYMENT
}

model Guarantee {
  id          String        @id @db.VarChar(26)
  contractId  String        @db.VarChar(26)
  type        GuaranteeType
  amount      Decimal       @db.Decimal(20, 4)
  currency    String        @default("PKR") @db.VarChar(3)
  furnishedOn DateTime?     @db.Date
  expiresOn   DateTime?     @db.Date
  createdAt   DateTime      @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, type])
}

model Invoice {
  id            String   @id @db.VarChar(26)
  contractId    String   @db.VarChar(26)
  invoiceNumber String   @db.VarChar(60)
  receivedOn    DateTime @db.Date // invoice / running bill received
  amount        Decimal  @db.Decimal(20, 4)
  currency      String   @default("PKR") @db.VarChar(3)
  createdAt     DateTime @default(now()) @db.DateTime(6)

  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([contractId])
}

model Payment {
  id         String   @id @db.VarChar(26)
  invoiceId  String   @db.VarChar(26)
  contractId String   @db.VarChar(26)
  paidOn     DateTime @db.Date
  amount     Decimal  @db.Decimal(20, 4)
  currency   String   @default("PKR") @db.VarChar(3)
  createdAt  DateTime @default(now()) @db.DateTime(6)

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([invoiceId])
}

model LetterOfCredit {
  id         String    @id @db.VarChar(26)
  contractId String    @db.VarChar(26)
  lcNumber   String    @db.VarChar(60)
  openedOn   DateTime? @db.Date
  createdAt  DateTime  @default(now()) @db.DateTime(6)

  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amendments LCAmendment[]

  @@index([contractId])
}

model LCAmendment {
  id               String    @id @db.VarChar(26)
  letterOfCreditId String    @db.VarChar(26)
  requestedOn      DateTime  @db.Date // case for LC amendment received
  finalizedOn      DateTime? @db.Date // LC amendment finalised with the bank
  createdAt        DateTime  @default(now()) @db.DateTime(6)

  letterOfCredit LetterOfCredit @relation(fields: [letterOfCreditId], references: [id], onDelete: Cascade)

  @@index([letterOfCreditId])
}

// =============================================================================
// Compliance-controls (PPRA + DPP&I-35 — ZeroLink gap fills)
//
// Three cross-cutting controls the base system did not capture, each guarding a
// workflow transition elsewhere:
//
//   - Blacklist      (PPRA Rule 19)   — bars award / invite to a blacklisted firm
//   - IntegrityPact  (PPRA Rule 7)    — required for every procurement > PKR 10M
//   - Grievance      (PPRA Rules 48/50; DPP&I-35 Ch XXVIII)
//                                     — bars PR issue / contract award while PENDING
//
// `Firm.isBlacklisted` is kept as a denormalised fast-path flag that the
// Blacklist use-cases keep in sync; the authoritative source is the Blacklist
// row set.
// =============================================================================

enum BlacklistStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BlacklistGround {
  CORRUPT_PRACTICE
  FRAUDULENT_PRACTICE
  COERCIVE_PRACTICE
  COLLUSIVE_PRACTICE
  OBSTRUCTIVE_PRACTICE
  PERFORMANCE_FAILURE
  BID_DEVIATION
  OTHER
}

model Blacklist {
  id              String          @id @db.VarChar(26)
  firmId          String          @db.VarChar(26)
  declaredOn      DateTime        @db.Date
  effectiveFrom   DateTime        @db.Date
  effectiveUntil  DateTime?       @db.Date // null = indefinite until revoked
  ground          BlacklistGround
  reason          String          @db.Text
  decidedByUserId String          @db.VarChar(26)
  documentKey     String?         @db.VarChar(500) // S3/object-store key for the signed order
  status          BlacklistStatus @default(ACTIVE)
  revokedOn       DateTime?       @db.Date
  revokedByUserId String?         @db.VarChar(26)
  revokedReason   String?         @db.Text
  createdAt       DateTime        @default(now()) @db.DateTime(6)
  updatedAt       DateTime        @updatedAt @db.DateTime(6)
  version         Int             @default(0)

  firm Firm @relation(fields: [firmId], references: [id])

  @@index([firmId, status])
  @@index([status, effectiveUntil])
}

model IntegrityPact {
  id                  String    @id @db.VarChar(26)
  indentId            String    @db.VarChar(26)
  firmId              String    @db.VarChar(26)
  signedByBuyerUserId String    @db.VarChar(26)
  signedByBuyerOn     DateTime  @db.Date
  signedBySupplierOn  DateTime? @db.Date // populated once the firm counter-signs
  documentKey         String?   @db.VarChar(500)
  createdAt           DateTime  @default(now()) @db.DateTime(6)
  updatedAt           DateTime  @updatedAt @db.DateTime(6)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  firm   Firm   @relation(fields: [firmId], references: [id])

  @@unique([indentId, firmId]) // one pact per firm per indent
  @@index([indentId])
}

enum GrievanceStatus {
  PENDING
  UPHELD
  REJECTED
  WITHDRAWN
  APPEALED
}

enum GrievanceStage {
  PRE_AWARD   // raised before award — blocks PR issue + contract award
  POST_AWARD  // raised after award — informational / appeals
}

model Grievance {
  id                String          @id @db.VarChar(26)
  indentId          String          @db.VarChar(26)
  firmId            String?         @db.VarChar(26) // null = anonymous bidder complaint
  filedByUserId     String?         @db.VarChar(26) // internal filer when applicable
  filedOn           DateTime        @db.Date
  basis             String          @db.Text        // the complaint, as filed
  stage             GrievanceStage  @default(PRE_AWARD)
  status            GrievanceStatus @default(PENDING)
  grcDecisionOn     DateTime?       @db.Date        // PPRA Rule 48/50 — decide within 10 working days
  grcDecisionText   String?         @db.Text
  appealedToPPRAOn  DateTime?       @db.Date
  documentKey       String?         @db.VarChar(500)
  createdAt         DateTime        @default(now()) @db.DateTime(6)
  updatedAt         DateTime        @updatedAt @db.DateTime(6)
  version           Int             @default(0)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  firm   Firm?  @relation(fields: [firmId], references: [id])

  @@index([indentId, status])
  @@index([status, filedOn])
}

// =============================================================================
// Execution-stage obligations (DPP&I-35 Ch XIII delivery period + LD; Ch XVI
// inspection + discrepancies).
//
//   - DeliveryPeriodExtension — a formal extension of the contractual DP,
//     recorded with reason, authority, and the new DP date.
//   - LiquidatedDamages      — assessment against the supplier for a delay.
//     Typically 2% per month of delay, capped at 10% of contract value.
//   - Inspection             — Inspectorate check of delivered stores.
//                              The outcome gates the Taking-Over Certificate.
//   - Discrepancy            — a specific defect raised during an Inspection
//                              and resolved before closure.
// =============================================================================

model DeliveryPeriodExtension {
  id              String   @id @db.VarChar(26)
  contractId      String   @db.VarChar(26)
  previousDP      DateTime @db.Date
  newDP           DateTime @db.Date
  reason          String   @db.Text
  grantedByUserId String   @db.VarChar(26)
  grantedOn       DateTime @db.Date
  documentKey     String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, grantedOn])
}

enum LDBasis {
  PER_DAY     // amount per day of delay
  PER_WEEK    // amount per week of delay
  PER_MONTH   // amount per month of delay (DPP&I-35 default)
  LUMP_SUM
}

model LiquidatedDamages {
  id            String   @id @db.VarChar(26)
  contractId    String   @db.VarChar(26)
  assessedOn    DateTime @db.Date
  periodFrom    DateTime @db.Date // start of the delay window
  periodTo      DateTime @db.Date // end of the delay window
  basis         LDBasis  @default(PER_MONTH)
  amount        Decimal  @db.Decimal(20, 4) // the LD amount assessed
  currency      String   @default("PKR") @db.VarChar(3)
  waivedAmount  Decimal? @db.Decimal(20, 4) // waiver / discount granted
  waivedReason  String?  @db.Text
  assessedByUserId String @db.VarChar(26)
  createdAt     DateTime @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, assessedOn])
}

enum InspectionVerdict {
  ACCEPTED
  DISCREPANCY
  REJECTED
}

model Inspection {
  id                String            @id @db.VarChar(26)
  contractId        String            @db.VarChar(26)
  performedByUserId String            @db.VarChar(26) // INSPECTORATE
  performedOn       DateTime          @db.Date
  verdict           InspectionVerdict
  summary           String            @db.Text
  documentKey       String?           @db.VarChar(500)
  createdAt         DateTime          @default(now()) @db.DateTime(6)

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  discrepancies Discrepancy[]

  @@index([contractId, performedOn])
}

// =============================================================================
// Annual Procurement Plan (PPRA Rule 8)
//
// Each fiscal year carries at most one PUBLISHED plan comprising line items
// (planned procurements). An indent should ideally link to a plan line via
// `plannedItemId`. The schema allows that link optionally so existing
// indents remain valid.
// =============================================================================

enum AnnualPlanStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

model AnnualProcurementPlan {
  id                 String                      @id @db.VarChar(26)
  fiscalYearId       String                      @db.VarChar(26)
  publishedOn        DateTime?                   @db.Date
  publishedByUserId  String?                     @db.VarChar(26)
  status             AnnualPlanStatus            @default(DRAFT)
  totalEstimate      Decimal?                    @db.Decimal(20, 4)
  currency           String                      @default("PKR") @db.VarChar(3)
  notes              String?                     @db.Text
  createdAt          DateTime                    @default(now()) @db.DateTime(6)
  updatedAt          DateTime                    @updatedAt @db.DateTime(6)
  version            Int                         @default(0)

  fiscalYear FiscalYear               @relation(fields: [fiscalYearId], references: [id])
  items      AnnualProcurementPlanItem[]

  @@unique([fiscalYearId, status]) // at most one DRAFT, one PUBLISHED per FY
  @@index([status])
}

model AnnualProcurementPlanItem {
  id                 String                      @id @db.VarChar(26)
  planId             String                      @db.VarChar(26)
  budgetHeadId       String                      @db.VarChar(26)
  description        String                      @db.VarChar(500)
  estimatedValue     Decimal                     @db.Decimal(20, 4)
  currency           String                      @default("PKR") @db.VarChar(3)
  methodHint         ProcurementMethod?
  categoryHint       ProcurementCategory?
  quarterHint        String?                     @db.VarChar(2) // "Q1".."Q4"
  createdAt          DateTime                    @default(now()) @db.DateTime(6)
  updatedAt          DateTime                    @updatedAt @db.DateTime(6)

  plan        AnnualProcurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  budgetHead  BudgetHead            @relation(fields: [budgetHeadId], references: [id])
  indents     Indent[]              @relation("PlanItemToIndent")

  @@index([planId])
  @@index([budgetHeadId])
}

// =============================================================================
// Standard Bidding Documents (PPRA Rule 23(4))
//
// Rule 23(4): procuring agencies "shall use standard bidding documents" issued
// by PPRA. A template library — each row is a versioned, kind-tagged document
// (goods / works / services / consultancy). An IT proforma can be tagged with
// a template id so compliance can bind.
// =============================================================================

enum BiddingDocumentKind {
  GOODS
  WORKS
  SERVICES
  CONSULTANCY
}

model BiddingDocumentTemplate {
  id          String              @id @db.VarChar(26)
  kind        BiddingDocumentKind
  name        String              @db.VarChar(200)
  revision    String              @db.VarChar(40) // "v1", "v2.1", "2026-01"
  publishedOn DateTime            @db.Date
  isActive    Boolean             @default(true)
  bodyKey     String?             @db.VarChar(500) // object-store key for the template body
  summary     String?             @db.Text
  createdAt   DateTime            @default(now()) @db.DateTime(6)
  updatedAt   DateTime            @updatedAt @db.DateTime(6)

  @@unique([kind, revision])
  @@index([kind, isActive])
}

// =============================================================================
// Execution evidence models (DPP&I-35 Chapters XVII–XX)
//
// Four small evidence records attached to a signed Contract:
//   - Insurance            (Ch XVII) — marine / war-risk cover on imports.
//   - Shipment             (Ch XVIII) — approved freight-forwarder dispatch.
//   - EndUserCertificate   (Ch XIX)  — EUC issued for controlled-goods imports.
//   - AgentCommission      (Ch XX)   — disclosed commission paid to an agent.
//
// None of these mutates the Contract. They are append-only evidence rows the
// compliance engine joins to the Contract/Indent for its reports.
// =============================================================================

enum InsuranceKind {
  MARINE
  WAR_RISK
  TRANSIT
  COMPREHENSIVE
  OTHER
}

model Insurance {
  id            String        @id @db.VarChar(26)
  contractId    String        @db.VarChar(26)
  kind          InsuranceKind
  policyNumber  String        @db.VarChar(60)
  insurer       String        @db.VarChar(255)
  coverFromDate DateTime      @db.Date
  coverToDate   DateTime      @db.Date
  premium       Decimal       @db.Decimal(20, 4)
  currency      String        @default("PKR") @db.VarChar(3)
  documentKey   String?       @db.VarChar(500)
  createdAt     DateTime      @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

enum ShipmentMode {
  SEA
  AIR
  ROAD
  RAIL
  COURIER
}

model Shipment {
  id                 String       @id @db.VarChar(26)
  contractId         String       @db.VarChar(26)
  invoiceId          String?      @db.VarChar(26) // link to the invoice it fulfils, if any
  mode               ShipmentMode
  blAwbNumber        String       @db.VarChar(80) // Bill-of-Lading or Airway-Bill number
  dispatchedOn       DateTime     @db.Date
  receivedOn         DateTime?    @db.Date
  freightForwarder   String?      @db.VarChar(255)
  originPort         String?      @db.VarChar(120)
  destinationPort    String?      @db.VarChar(120)
  documentKey        String?      @db.VarChar(500)
  createdAt          DateTime     @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, dispatchedOn])
}

model EndUserCertificate {
  id                     String   @id @db.VarChar(26)
  contractId             String   @db.VarChar(26)
  issuedOn               DateTime @db.Date
  issuingAuthorityUserId String   @db.VarChar(26)
  endUserOrganisation    String   @db.VarChar(255)
  controlledGoodsDesc    String   @db.Text
  documentKey            String?  @db.VarChar(500)
  createdAt              DateTime @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model AgentCommission {
  id             String   @id @db.VarChar(26)
  contractId     String   @db.VarChar(26)
  agentName      String   @db.VarChar(255)
  agentFirmId    String?  @db.VarChar(26)
  percent        Decimal  @db.Decimal(6, 3) // e.g. 2.500 = 2.5%
  amount         Decimal  @db.Decimal(20, 4)
  currency       String   @default("PKR") @db.VarChar(3)
  disclosedOn    DateTime @db.Date
  approvedByUserId String? @db.VarChar(26)
  approvedOn     DateTime? @db.Date
  documentKey    String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.DateTime(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// =============================================================================
// Committees (PPRA Rule 48 GRC + general TEC / FEC)
//
// A committee has a kind (GRC — grievance redressal; TEC — tender evaluation;
// FEC — finance evaluation; OTHER), a term, and an ordered list of members.
// The service layer enforces "odd-number members" for GRC bodies.
// =============================================================================

enum CommitteeKind {
  GRC
  TEC
  FEC
  INSPECTION
  OTHER
}

model Committee {
  id          String        @id @db.VarChar(26)
  kind        CommitteeKind
  name        String        @db.VarChar(200)
  termStart   DateTime      @db.Date
  termEnd     DateTime?     @db.Date
  isActive    Boolean       @default(true)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @db.DateTime(6)
  updatedAt   DateTime      @updatedAt @db.DateTime(6)
  version     Int           @default(0)

  members CommitteeMember[]

  @@index([kind, isActive])
}

model CommitteeMember {
  id            String    @id @db.VarChar(26)
  committeeId   String    @db.VarChar(26)
  userId        String    @db.VarChar(26) // User (civilian/military identity in the User table)
  memberRole    String    @db.VarChar(80)  // "Chair", "Secretary", "Member", etc.
  joinedOn      DateTime  @db.Date
  leftOn        DateTime? @db.Date
  createdAt     DateTime  @default(now()) @db.DateTime(6)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([committeeId])
}

// =============================================================================
// Contract amendments (DPP&I-35 Ch XXI)
//
// A formal amendment to a signed Contract — scope (QTY/DP/VALUE/SPEC/OTHER),
// delta value where applicable, request + approval dates, approving authority,
// reason, and the supporting document key.
// =============================================================================

enum ContractAmendmentScope {
  QTY       // quantity change
  DP        // delivery period change (companion to DeliveryPeriodExtension)
  VALUE     // value change
  SPEC      // technical specification change
  OTHER
}

enum ContractAmendmentStatus {
  PROPOSED
  APPROVED
  REJECTED
}

model ContractAmendment {
  id                  String                  @id @db.VarChar(26)
  contractId          String                  @db.VarChar(26)
  scope               ContractAmendmentScope
  summary             String                  @db.Text        // one-paragraph change description
  deltaValue          Decimal?                @db.Decimal(20, 4) // signed; positive = add, negative = reduce
  deltaCurrency       String?                 @db.VarChar(3)
  requestedOn         DateTime                @db.Date
  approvedOn          DateTime?               @db.Date
  approvedByUserId    String?                 @db.VarChar(26)
  status              ContractAmendmentStatus @default(PROPOSED)
  rejectionReason     String?                 @db.Text
  documentKey         String?                 @db.VarChar(500)
  createdAt           DateTime                @default(now()) @db.DateTime(6)
  updatedAt           DateTime                @updatedAt @db.DateTime(6)
  version             Int                     @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

// =============================================================================
// Firm registration / pre-qualification (PPRA Rules 15–16; DPP&I-35 Ch XXVI)
//
// A firm must be registered with DP(Navy) for a defined set of categories
// before it may be invited to an IT. Registration carries a validity window;
// an expired registration is treated as "not registered" at IT-invite time.
// Renewal creates a new row rather than mutating in place, so the history is
// preserved for audit.
// =============================================================================

enum FirmRegistrationCategory {
  GOODS
  WORKS
  SERVICES
  ARMAMENT_AMMUNITION
  ELECTRONICS
  VEHICLES
  MEDICAL
  TEXTILES
  AVIATION
  SHIPBUILDING
  IT_SOFTWARE
  OTHER
}

enum FirmRegistrationStatus {
  PENDING    // documents submitted, awaiting vetting
  APPROVED   // lead agency has issued the certificate
  REJECTED   // declined with reasons
  EXPIRED    // validUntil passed
  REVOKED    // cancelled before expiry
}

model FirmRegistration {
  id              String                       @id @db.VarChar(26)
  firmId          String                       @db.VarChar(26)
  submittedOn     DateTime                     @db.Date
  issuedOn        DateTime?                    @db.Date
  validUntil      DateTime?                    @db.Date
  category        FirmRegistrationCategory
  status          FirmRegistrationStatus       @default(PENDING)
  certificateKey  String?                      @db.VarChar(500) // object-store key for issued certificate
  reviewedByUserId String?                     @db.VarChar(26)
  reviewNotes     String?                      @db.Text
  revokedOn       DateTime?                    @db.Date
  revokedReason   String?                      @db.Text
  createdAt       DateTime                     @default(now()) @db.DateTime(6)
  updatedAt       DateTime                     @updatedAt @db.DateTime(6)
  version         Int                          @default(0)

  firm Firm @relation(fields: [firmId], references: [id])

  @@index([firmId, category, status])
  @@index([validUntil, status])
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
  WAIVED
}

model Discrepancy {
  id              String             @id @db.VarChar(26)
  inspectionId    String             @db.VarChar(26)
  raisedOn        DateTime           @db.Date
  description     String             @db.Text
  severity        String             @db.VarChar(40) // MINOR/MAJOR/CRITICAL (open-ended for taxonomy evolution)
  status          DiscrepancyStatus  @default(OPEN)
  resolvedOn      DateTime?          @db.Date
  resolutionNotes String?            @db.Text
  createdAt       DateTime           @default(now()) @db.DateTime(6)
  updatedAt       DateTime           @updatedAt @db.DateTime(6)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, status])
}
